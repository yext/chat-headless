{
  "private": true,
  "name": "chat-headless",
  "version": "0.1.0",
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "lint": "prettier --write . && eslint --fix --max-warnings=0 .",
    "test": "turbo run test --filter='./packages/*'"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "rollup@2": "2.80.0",
    "svgo@2": "2.8.1",
    "webpack-dev-server": {
      "webpack-dev-middleware": "7.4.6"
    }
  },
  "devDependencies": {
    "@yext/eslint-config": "^1.0.0",
    "eslint": "^8.40.0",
    "generate-license-file": "^2.0.0",
    "prettier": "^2.8.8",
    "turbo": "latest"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
